# Скопируй в .env и заполни: cp .env.example .env
# Сам .env в git не попадает (.gitignore). Пустые значения = умолчания из ragkit/config.py.

# обязательно
APP_API_KEY=

# необязательно
APP_DATABASE_URL=
APP_MAX_RETRIES=
APP_DEBUG=
APP_LLM__MODEL=
APP_LLM__TIMEOUT=

# Ф3-08: аутентификация
# APP_JWT_SECRET пусто → случайный при каждом запуске (токены умирают при рестарте).
# Комментарий — отдельной строкой: после «KEY=» он стал бы значением.
APP_JWT_SECRET=
APP_JWT_TTL_MINUTES=
APP_BCRYPT_ROUNDS=
APP_RATE_LIMIT_PER_MINUTE=
APP_MAX_DOCUMENTS_PER_OWNER=
