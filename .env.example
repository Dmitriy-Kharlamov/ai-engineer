# Скопируй в .env и заполни: cp .env.example .env
# Сам .env в git не попадает (.gitignore). Пустые значения = умолчания из ragkit/config.py.

# обязательно
APP_API_KEY=

# необязательно
APP_DATABASE_URL=
APP_MAX_RETRIES=
APP_DEBUG=
APP_LLM__MODEL=
APP_LLM__TIMEOUT=

# Ф3-08: аутентификация
# APP_JWT_SECRET обязателен при APP_DEBUG=false (Ф3-11): без него сервис не стартует.
# Пусто при APP_DEBUG=true → случайный при каждом запуске (токены умирают при рестарте).
# Не короче 32 байт: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Комментарий — отдельной строкой: после «KEY=» он стал бы значением.
APP_JWT_SECRET=
APP_JWT_TTL_MINUTES=
APP_BCRYPT_ROUNDS=
APP_RATE_LIMIT_PER_MINUTE=
APP_MAX_DOCUMENTS_PER_OWNER=

# Ф3-11: размерность эмбеддера (0 — сервис жив, но не готов: проверка healthcheck)
APP_EMBEDDER_DIM=
